<view class="screen books-page"><page-background scene="8"/><page-header title="全部礼簿"/><view class="page"><view class="search-box"><ui-icon name="action_search" size="32"/><input placeholder="搜索礼簿名称、事件、年份" value="{{keyword}}" bindinput="input"/></view><view class="filters"><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="filter-pill">{{types[typeIndex]}}<text>▾</text></view></picker><picker range="{{years}}" value="{{yearIndex}}" bindchange="year"><view class="filter-pill">{{years[yearIndex]}}<text>▾</text></view></picker></view><view class="books-year"><section-title title="{{yearIndex === 0 ? '二〇二六' : years[yearIndex]}}"/></view><view class="ledger-list"><button wx:for="{{books}}" wx:key="id" class="ledger-item frame tap" data-id="{{item.id}}" bindtap="open"><book-cover cover="{{item.cover}}" label="{{item.name}}"/><view class="ledger-info"><text class="ledger-title">{{item.name}}</text><text class="ledger-subtitle">— {{item.subtitle}} —</text><view class="ledger-meta"><ui-icon name="nav_calendar_outline" size="25"/><text>{{item.lunar}}</text></view><view class="ledger-meta"><ui-icon name="nav_ledger_outline" size="25"/><text class="money">{{item.count}}</text><text>笔</text></view></view><ui-icon name="action_next" size="29"/></button><view wx:if="{{!books.length}}" class="empty">暂无匹配的礼簿</view></view><view class="center-action"><action-button label="新建礼簿" bind:action="create"/></view></view><bottom-nav selected="{{0}}"/><new-book-modal show="{{showCreate}}" bind:close="close" bind:created="created"/></view>
