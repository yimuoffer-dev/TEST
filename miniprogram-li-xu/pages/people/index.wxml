<view class="screen people-page"><page-background scene="9"/><page-header hero="{{true}}"/><view class="page"><view class="people-hero"><text>— 人情往来 —</text></view><view class="search-box"><ui-icon name="action_search" size="32"/><input placeholder="搜索姓名、关系、事件" value="{{keyword}}" bindinput="input"/></view><view class="stats-strip frame"><view><text>收礼</text><text class="stat-number">{{counters.received}}</text></view><view><text>送礼</text><text class="stat-number">{{counters.sent}}</text></view><view><text>往来人数</text><text class="stat-number">{{counters.people}}</text></view></view><view class="people-tabs"><segment-tabs items="{{groups}}" value="{{group}}" bind:change="change"/></view><view class="contact-list"><button wx:for="{{people}}" wx:key="id" class="contact-card frame tap" data-id="{{item.id}}" bindtap="open"><flower-badge art="{{item.art}}" size="80"/><view class="contact-name"><text class="row-name">{{item.name}}</text><text class="tag">{{item.relation}}</text></view><view class="contact-event"><text>{{item.event}}</text><text class="muted">{{item.date}}</text><text class="muted">近三年往来 <text class="money">{{item.frequency}}</text> 次</text></view><text class="amount"><text class="currency">¥</text>{{item.amount}}</text><ui-icon name="action_next" size="25"/></button><view wx:if="{{!people.length}}" class="empty">暂无匹配的往来记录</view></view></view></view>
