<view class="screen entry-page"><page-background scene="6" branch="{{false}}"/><page-header title="记 一 笔"/><view wx:if="{{book}}" class="page"><view class="entry-summary frame"><book-cover kind="compact" cover="{{book.cover}}" label="{{book.name}}"/><view><text class="entry-summary-title">{{book.name}}</text><text class="entry-summary-date">{{book.longDate}}</text></view></view><view class="direction-toggle frame"><button class="tap {{direction === 'in' ? 'selected' : ''}}" data-value="in" bindtap="direction"><ui-icon name="action_download" size="38"/><text>收礼</text></button><button class="tap {{direction === 'out' ? 'selected' : ''}}" data-value="out" bindtap="direction"><ui-icon name="state_gift_sent" size="38"/><text>送礼</text></button></view><view class="entry-field frame"><flower-badge art="decor_plum" size="59"/><text class="field-label">姓名</text><input value="{{name}}" placeholder="请输入姓名" maxlength="30" data-field="name" bindinput="input"/></view><view class="entry-field relation-field frame"><flower-badge art="decor_bamboo" size="59"/><text class="field-label">关系</text><view class="relation-options"><button wx:for="{{relations}}" wx:key="*this" class="tap {{relation === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="relation">{{item}}</button></view></view><view class="entry-field money-field frame"><flower-badge art="decor_chrysanthemum" size="59"/><text class="field-label">礼金</text><view class="money-input" aria-label="礼金 {{amount}}"><text class="currency">¥</text><text>{{amount || '0'}}</text></view><image class="money-cloud" src="/assets/decor_cloud.webp" mode="aspectFit"/></view><view class="entry-field frame gift-field"><flower-badge art="decor_ginkgo" size="59"/><text class="field-label">礼品</text><input value="{{gift}}" placeholder="可选填写" maxlength="120" data-field="gift" bindinput="input"/></view><view class="entry-field frame"><flower-badge art="decor_chrysanthemum" size="59"/><text class="field-label">备注</text><input value="{{note}}" placeholder="写下简短说明" maxlength="240" data-field="note" bindinput="input"/></view><view class="amount-keypad"><block wx:for="{{keys}}" wx:key="value"><view wx:if="{{item.value === 'spacer'}}" class="key key-spacer"></view><button wx:else class="key tap {{item.className || ''}} {{item.value === '清空' ? 'clear-key' : ''}}" data-value="{{item.value}}" bindtap="key" hover-class="pressed">{{item.value}}</button></block></view><view class="save-actions"><button class="save-secondary frame tap" disabled="{{saving}}" data-continue="{{false}}" bindtap="save">保存</button><button class="save-primary tap" disabled="{{saving}}" data-continue="{{true}}" bindtap="save">保存并继续</button></view></view><view wx:else class="empty">礼簿不存在，请返回选择。</view></view>
