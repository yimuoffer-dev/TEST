<view class="screen person-page"><page-background scene="9" branch="{{false}}"/><page-header title="{{person ? person.name : '亲友详情'}}" action="action_more" bind:action="more"/><view wx:if="{{person}}" class="page"><view class="person-summary frame"><flower-badge art="{{person.art}}" size="122"/><view class="person-info"><text class="person-name">{{person.name}}</text><text class="tag red">{{person.relation}}</text><text class="person-motto">— 往来有度，情谊常在 —</text></view></view><view class="stats-strip frame person-totals"><view><text>累计收礼</text><text class="stat-number"><text class="currency">¥</text>{{person.received}}</text></view><view><text>累计送礼</text><text class="stat-number"><text class="currency">¥</text>{{person.sent}}</text></view><view><text>往来</text><text class="stat-number">{{person.frequency}} <text class="count-unit">次</text></text></view></view><view class="person-tabs"><segment-tabs items="{{tabs}}" value="{{tab}}" bind:change="change"/></view><view class="person-record-title"><section-title title="往来记录"/></view><view class="timeline"><view wx:for="{{rows}}" wx:key="id" class="timeline-row frame"><view class="timeline-dot"></view><flower-badge art="{{item.art}}" size="65"/><view class="timeline-event"><text class="row-name">{{item.event}}</text><text class="tag {{item.direction === 'in' ? 'red' : ''}}">{{item.directionText}}</text></view><text class="timeline-date">{{item.lunar || item.dateText}}</text><text class="amount"><text class="currency">¥</text>{{item.amount}}</text></view><view wx:if="{{!rows.length}}" class="empty">暂无此类往来</view></view><view class="person-note-title"><section-title title="往来备注"/></view><view class="person-note frame">{{person.note || '暂无备注'}}</view><view class="center-action person-entry-action"><action-button label="新增往来" bind:action="entry"/></view></view><view wx:else class="empty">未找到该亲友。</view><bottom-nav selected="{{1}}"/></view>
