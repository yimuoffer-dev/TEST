<view class="screen profile-page"><page-background scene="8"/><page-header title="我的" back="{{false}}" action="action_settings" bind:action="settings"/><view class="page"><view class="profile-card frame"><view class="profile-top"><flower-badge art="decor_bamboo" size="158"/><view class="profile-info"><text class="profile-name">张 明</text><text class="profile-motto">— 家之礼，有簿可循 —</text><button class="member-pill tap" bindtap="member">♛ 礼序典藏用户</button></view></view><view class="profile-counts"><view><view class="count-label"><ui-icon name="nav_ledger_outline" size="30"/><text>礼簿</text></view><text>{{counters.books}}</text></view><view><view class="count-label"><ui-icon name="nav_people_outline" size="30"/><text>亲友</text></view><text>{{counters.people}}</text></view><view><view class="count-label"><ui-icon name="stat_list" size="30"/><text>记录</text></view><text>{{counters.records}}</text></view></view></view><view class="profile-section"><section-title title="我的礼簿服务"/></view><view class="service-list frame"><button wx:for="{{services}}" wx:key="action" class="service-row tap" data-action="{{item.action}}" bindtap="service"><view class="service-icon"><ui-icon name="{{item.icon}}" size="48"/></view><text>{{item.label}}</text><ui-icon name="action_next" size="25"/></button></view><view class="profile-section"><section-title title="管理与工具"/></view><view class="service-list frame"><button wx:for="{{tools}}" wx:key="action" class="service-row tap" data-action="{{item.action}}" bindtap="service"><view class="service-icon"><ui-icon name="{{item.icon}}" size="48"/></view><text>{{item.label}}</text><ui-icon name="action_next" size="25"/></button></view></view><new-book-modal show="{{showCreate}}" bind:close="close" bind:created="created"/></view>
