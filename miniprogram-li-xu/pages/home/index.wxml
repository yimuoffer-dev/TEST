<view class="screen home"><page-background scene="6"/><page-header hero="{{true}}"/><view class="page home-page"><view class="brand-hero"><view class="brand-title">礼序<text class="brand-seal">礼序</text></view><view class="brand-subtitle">— 往来有礼，岁月留情 —</view></view><view class="search-box"><ui-icon name="action_search" size="32"/><input value="{{query}}" placeholder="查找亲友、礼簿、往来记录" bindinput="searchInput" bindconfirm="search" confirm-type="search"/><button class="search-trigger tap" bindtap="search" aria-label="搜索"></button></view><view class="home-first-title"><section-title title="我的礼簿" more="{{true}}" bind:more="allBooks"/></view><view class="home-books"><button wx:for="{{books}}" wx:key="id" class="home-book tap" data-id="{{item.id}}" bindtap="openBook"><book-cover cover="{{item.cover}}" label="{{item.name}}" kind="home"/><view class="book-note frame"><text>{{item.subtitle}}</text><text class="book-note-date">—　{{item.lunar}}　—</text><view><ui-icon name="stat_list" size="24"/> 收礼记录 <text class="money">{{item.count}}</text> 笔</view></view></button></view><button class="new-ledger frame tap" bindtap="create"><ui-icon name="action_add" size="58"/><view class="new-ledger-text">新开一册礼簿<text>为重要的日子留下记录</text></view><image class="inline-cloud" src="/assets/decor_cloud.webp" mode="aspectFit"/></button><view class="home-recent-title"><section-title title="近日往来" more="{{true}}" bind:more="allPeople"/></view><view class="rows frame home-recent"><button wx:for="{{recent}}" wx:key="id" class="record-row tap" data-id="{{item.personId}}" bindtap="openPerson"><flower-badge art="{{item.art}}" size="72"/><view class="row-main"><text class="row-name">{{item.name}} · {{item.event}}</text><text class="tag {{item.direction === 'in' ? 'red' : ''}}">{{item.directionText}}</text></view><text class="amount"><text class="currency">¥</text>{{item.amount}}</text></button></view></view><new-book-modal show="{{showCreate}}" bind:close="close" bind:created="created"/></view>
