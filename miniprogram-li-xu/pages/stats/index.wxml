<view class="screen stats-page"><page-background scene="6"/><page-header title="礼簿统计" back="{{false}}"/><view class="page"><view class="year-selector"><button class="tap" aria-label="上一年" bindtap="previous">‹</button><button class="year-text tap" bindtap="choose">{{year === 2026 ? '二〇二六' : year}}年度 ▾</button><button class="tap" aria-label="下一年" bindtap="next">›</button></view><view class="metric-grid"><view class="metric-card frame"><view class="metric-badge"><ui-icon name="event_wedding" size="42"/></view><text>收礼总额</text><text class="metric-value"><text class="currency">¥</text>{{stats.received}}</text><image src="/assets/decor_cloud.webp" class="metric-cloud" mode="aspectFit"/></view><view class="metric-card frame"><view class="metric-badge"><ui-icon name="action_export" size="42"/></view><text>送礼总额</text><text class="metric-value"><text class="currency">¥</text>{{stats.sent}}</text><image src="/assets/decor_cloud.webp" class="metric-cloud" mode="aspectFit"/></view><view class="metric-card frame"><view class="metric-badge"><ui-icon name="nav_people_outline" size="42"/></view><text>往来人数</text><text class="metric-value">{{stats.count}}</text><image src="/assets/decor_cloud.webp" class="metric-cloud" mode="aspectFit"/></view></view><view class="stats-section"><section-title title="年度收送趋势"/></view><view class="trend-panel frame"><image wx:if="{{stats.baseline}}" src="/assets/chart-trend.png" mode="scaleToFill" class="trend-image" aria-label="2026年度收礼送礼趋势柱状图"/><view wx:else class="empty">{{stats.empty ? '本年度暂无往来记录' : '本年度往来如下'}} </view><view wx:if="{{stats.hasBreakdown}}" class="new-data-note">{{stats.baseline ? '下方为本机新增记录，不包含参考图汇总。' : '下方按本年度可用记录汇总。'}}</view></view><view wx:if="{{stats.hasBreakdown}}" class="monthly-data frame"><view wx:for="{{monthly}}" wx:key="month" wx:if="{{item.received || item.sent}}" class="monthly-line"><text>{{item.month}}月</text><text>收礼 ¥{{item.inText}}</text><text>送礼 ¥{{item.outText}}</text></view></view><view class="stats-section"><section-title title="礼簿分类占比"/></view><view class="category-panel frame"><view wx:if="{{stats.baseline}}" class="donut-image-wrap"><image src="/assets/chart-donut.png" mode="aspectFit" class="donut-image"/><view class="donut-center"><image src="/assets/decor_plum.webp" mode="aspectFit"/><text>总额</text><text class="donut-total">¥224,900</text></view></view><view wx:else class="category-empty">暂无参考分类数据</view><view wx:if="{{stats.baseline}}" class="category-legend"><view wx:for="{{categories}}" wx:key="name" class="category-row"><flower-badge wx:if="{{item.art !== 'event_housewarming'}}" art="{{item.art}}" size="54"/><ui-icon wx:else name="event_housewarming" size="54"/><view><text class="category-name">{{item.name}}</text><text class="category-value">¥{{item.value}}</text></view><text class="category-ratio">{{item.ratio}}</text></view></view></view><view class="stats-section ranking-heading"><section-title title="往来频次前五"/></view><view class="ranking-list frame"><button wx:for="{{ranking}}" wx:key="id" class="ranking-row tap" data-id="{{item.id}}" bindtap="person"><flower-badge art="{{item.art}}" size="44"/><text class="ranking-name">{{item.name}}</text><text class="ranking-count">{{item.frequency}}次</text><ui-icon name="action_next" size="23"/></button></view><text class="stats-footnote">2026 数据为参考界面演示汇总；本机新增收送单独列示。</text></view></view>
