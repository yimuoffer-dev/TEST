<view class="screen book-page"><page-background scene="6" branch="{{false}}"/><page-header title="{{book ? book.name : '礼簿详情'}}" action="action_more" bind:action="more"/><view wx:if="{{book}}" class="page"><view class="book-summary frame"><book-cover cover="{{book.cover}}" label="{{book.name}}" kind="summary"/><view class="summary-info"><text class="summary-title">{{book.name}}</text><text class="summary-motto">— {{book.subtitle}} —</text><text class="summary-date">{{book.longDate}}</text><text class="summary-host">主家：{{book.host}}</text><view class="summary-total"><text>收礼 <text class="money">{{book.count}}</text> 笔</text><text>合计 <text class="money">¥{{book.total}}</text></text></view></view></view><view class="book-tabs"><segment-tabs items="{{tabs}}" value="{{tab}}" bind:change="change"/></view><view class="book-detail-title"><section-title title="礼簿明细"/></view><view class="rows frame book-details"><button wx:for="{{rows}}" wx:key="id" class="record-row tap" data-id="{{item.personId}}" bindtap="person"><flower-badge art="{{item.art}}" size="64"/><view class="detail-name"><text class="row-name">{{item.name}}</text><text class="tag">{{item.relation}}</text></view><view class="detail-status"><text>{{item.status}}</text><text class="row-date">{{item.shortDate}} {{item.time}}</text></view><text class="amount"><text class="currency">¥</text>{{item.amount}}</text><ui-icon name="action_next" size="24"/></button><view wx:if="{{!rows.length}}" class="empty">暂无此类记录</view></view><view class="center-action book-entry-action"><action-button label="记一笔" bind:action="entry"/></view></view><view wx:else class="empty">礼簿不存在，请返回重新选择。</view><bottom-nav selected="{{0}}"/></view>
