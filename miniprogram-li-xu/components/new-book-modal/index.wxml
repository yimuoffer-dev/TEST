<view wx:if="{{show}}" class="modal-mask" bindtap="close"><view class="modal-panel frame" catchtap="stop"><view class="modal-title">新开一册礼簿<button class="modal-close tap" bindtap="close" aria-label="关闭">×</button></view><input class="modal-input" placeholder="礼簿名称" value="{{name}}" maxlength="30" bindinput="name"/><picker range="{{types}}" value="{{typeIndex}}" bindchange="type"><view class="modal-input">礼事类型　{{types[typeIndex]}}　⌄</view></picker><picker mode="date" value="{{date}}" bindchange="date"><view class="modal-input">日期　{{date}}</view></picker><input class="modal-input" value="{{host}}" placeholder="主家（可选）" maxlength="20" bindinput="host"/><action-button label="创建礼簿" disabled="{{saving}}" bind:action="save"/></view></view>
