.modal-mask{position:fixed;top:0;right:0;bottom:0;left:0;background:#31261c66;z-index:100;display:flex;align-items:center;justify-content:center;animation:appear .18s ease-out}.modal-panel{width:620rpx;padding:36rpx;background:#f6ecdf;box-sizing:border-box}.modal-title{font-size:32rpx;position:relative;margin-bottom:28rpx}.modal-close{position:absolute;right:0;top:-10rpx;font-size:40rpx}.modal-input{margin-bottom:20rpx;padding:18rpx;border:1px solid #d5bfa2;border-radius:10rpx;box-sizing:border-box;font-size:26rpx;min-height:68rpx;background:#fff8ed}.modal-panel action-button{margin-top:28rpx}@keyframes appear{from{opacity:0}to{opacity:1}}
